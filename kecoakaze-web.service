[Unit]
Description=Kecoakaze Web Level 1 Static Server
After=network.target

[Service]
Type=simple
User=lukman
Group=lukman
WorkingDirectory=/home/lukman/kecoakaze-web
Environment=PORT=8100
Environment=BIND=127.0.0.1
ExecStart=/usr/bin/python3 /home/lukman/kecoakaze-web/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
